<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve robots and sitemap directly
  RewriteRule ^(robots\.txt|sitemap\.xml)$ - [L]

  # If request is for existing file or directory, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise rewrite to client entry (index.csr.html)
  RewriteRule ^ /index.csr.html [L]
</IfModule>

# Optional: basic caching for common assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Security: disable directory listing
Options -Indexes
